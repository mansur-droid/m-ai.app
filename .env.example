# Public Supabase project values. Safe to expose to the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never prefix these with NEXT_PUBLIC and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
API_KEY_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key

# AI providers. Configure one or more; unconfigured providers remain unavailable in the UI.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=

GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_DEFAULT_MODEL=

XAI_API_KEY=
XAI_DEFAULT_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_DEFAULT_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
