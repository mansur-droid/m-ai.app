# Public Supabase project values. Safe to expose to the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 32-byte base64 key used later for encrypting user-supplied provider credentials.
API_KEY_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key
